     rclcpp::Subscription<ImageMsg>::SharedPtr subImgRight_;
 
     rclcpp::Publisher<geometry_msgs::msg::PoseStamped>::SharedPtr posePub_;
+    // 현재 Atlas 맵 id. 바뀌면 world 원점이 바뀐 것 (MoLBWA arm/anchor.py 가 latch 폐기)
+    rclcpp::Publisher<std_msgs::msg::Int32>::SharedPtr mapIdPub_;
     std::unique_ptr<tf2_ros::TransformBroadcaster> tfBroadcaster_;
     void PublishPose(const Sophus::SE3f &Tcw, const rclcpp::Time &stamp);
 
