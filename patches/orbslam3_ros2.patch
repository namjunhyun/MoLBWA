-            SLAM_->TrackStereo(imLeft, imRight, tImLeft, vImuMeas);
+            Sophus::SE3f Tcw = SLAM_->TrackStereo(imLeft, imRight, tImLeft, vImuMeas);
+
+            if (SLAM_->GetTrackingState() == ORB_SLAM3::Tracking::OK)
